FROM python:3.11-slim

# Prevent __pycache__ and ensure logs flush immediately
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Runtime dependency for XGBoost (OpenMP)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first for better layer caching
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app ./app
# Optional: copy dataset/models if present (compose mounts models volume)
COPY models ./models
COPY koi-cumulative.csv ./

EXPOSE 8000

# Healthcheck for compose and better observability
HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=6 \
  CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1

ENV LOG_LEVEL=info
CMD ["sh", "-c", "uvicorn app.api:app --host 0.0.0.0 --port 8000 --log-level ${LOG_LEVEL}"]
